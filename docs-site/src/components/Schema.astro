---
// A JSON Schema's fields as a list: each one's name, type, whether it is required, what it is and
// the limits it keeps, with an object's own fields folded under it; a schema with no fields is its
// type alone. No script: `<details>` folds.
import { descriptionHtml, factsOf, hasFields, type JsonSchema, nestedOf, typeOf } from "../lib/schema.ts";

interface Props {
  schema: JsonSchema;
}

const { schema } = Astro.props;
const required = new Set(schema.required ?? []);
---

{
  hasFields(schema) ? (
    <ul class="schema not-content">
      {Object.entries(schema.properties ?? {}).map(([name, field]) => {
        const facts = factsOf(field);
        return (
          <li>
            <span class="schema-name">{name}</span>
            <span class="schema-type">{typeOf(field)}</span>
            {required.has(name) && <span class="schema-required">required</span>}
            {field.description && <p class="schema-description" set:html={descriptionHtml(field.description)} />}
            {facts.length > 0 && <p class="schema-facts">{facts.join(", ")}</p>}
            {nestedOf(field).map(({ label, schema: inner }) => (
              <details>
                <summary>{label}</summary>
                <Astro.self schema={inner} />
              </details>
            ))}
          </li>
        );
      })}
    </ul>
  ) : (
    <p>
      <code>{typeOf(schema)}</code>, with no fields.
    </p>
  )
}
