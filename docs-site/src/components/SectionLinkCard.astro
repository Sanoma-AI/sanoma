---
import { LinkCard } from "@astrojs/starlight/components";
import type { ComponentProps } from "astro/types";
import SectionIcon from "./SectionIcon.astro";

type Props = ComponentProps<typeof LinkCard> & { href: string };
---

<div class="section-card">
  <LinkCard {...Astro.props} />
  <span class="section-icon"><SectionIcon pathname={Astro.props.href} size="1.25rem" /></span>
</div>

<style>
  .section-card {
    position: relative;
    display: grid;
  }

  .section-card > :global(.sl-link-card) {
    padding-inline-start: 3rem;
  }

  .section-icon {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: 1.2rem;
    display: flex;
    pointer-events: none;
  }
</style>
