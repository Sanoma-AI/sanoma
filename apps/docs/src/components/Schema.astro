---
// A JSON Schema's fields as a list: each one's name, type, whether it is required, what it is and
// the limits it keeps, with an object's own fields folded under it. No script: `<details>` folds.
import { descriptionHtml, factsOf, type JsonSchema, nestedOf, resolve, typeOf } from "../lib/schema.ts";

interface Props {
  schema: JsonSchema;
  /** The schema `$ref`s are read from: the operation's whole input or output. */
  root?: JsonSchema;
}

const root = Astro.props.root ?? Astro.props.schema;
const schema = resolve(Astro.props.schema, root);
const required = new Set(schema.required ?? []);
const fields = Object.entries(schema.properties ?? {});
---

{
  fields.length > 0 && (
    <ul class="schema not-content">
      {fields.map(([name, given]) => {
        const field = resolve(given, root);
        const facts = factsOf(field, root);
        return (
          <li>
            <span class="schema-name">{name}</span>
            <span class="schema-type">{typeOf(field, root)}</span>
            {required.has(name) && <span class="schema-required">required</span>}
            {field.description && <p class="schema-description" set:html={descriptionHtml(field.description)} />}
            {facts.length > 0 && <p class="schema-facts">{facts.join(", ")}</p>}
            {nestedOf(field, root).map(({ label, schema: inner }) => (
              <details>
                <summary>{label}</summary>
                <Astro.self schema={inner} root={root} />
              </details>
            ))}
          </li>
        );
      })}
    </ul>
  )
}
