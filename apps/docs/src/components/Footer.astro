---
// Starlight's footer, then which release these pages describe: the `sanoma` package's version as
// it was when the site was built.
import Default from "@astrojs/starlight/components/Footer.astro";
import manifest from "../../../../packages/sanoma/package.json";
---

<Default><slot /></Default>
<p class="sanoma-version">
  These pages describe <a href={`https://www.npmjs.com/package/sanoma/v/${manifest.version}`}>sanoma {manifest.version}</a>.
</p>

<style>
  .sanoma-version {
    margin-top: 1.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
