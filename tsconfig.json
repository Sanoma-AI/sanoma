{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    // Inside the repo, @sanoma/* resolves to source so nothing needs building first.
    // Published packages resolve to dist/ through their package.json exports.
    // Keep in sync with resolve.alias in vitest.config.ts.
    "paths": {
      "@sanoma/workflows": ["./packages/workflows/src/index.ts"],
      "@sanoma/workflows/describe": ["./packages/workflows/src/describe.ts"],
      "@sanoma/workflows/fake": ["./packages/workflows/src/fake.ts"],
      "@sanoma/workflows/lint": ["./packages/workflows/src/lint.ts"],
      "@sanoma/workflows/shared": ["./packages/workflows/src/shared.ts"],
      "@sanoma/testing": ["./packages/testing/src/index.ts"],
      "@sanoma/testing/replay": ["./packages/testing/src/replay.ts"],
      "@sanoma/app": ["./packages/app/src/index.ts"],
      "@sanoma/bridge": ["./packages/bridge/src/index.ts"],
      "@sanoma/bridge/fake": ["./packages/bridge/src/fake.ts"],
      "@sanoma/bridge/connector": ["./packages/bridge/src/connector.ts"],
      "@sanoma/bridge/tfschema": ["./packages/bridge/src/tfschema.ts"],
      // Before the bare pattern: TypeScript takes the first of two patterns with equal prefixes.
      "@sanoma/connector-*/fake": ["./connectors/*/src/fake.ts"],
      "@sanoma/connector-*/driver": ["./connectors/*/src/driver.ts"],
      "@sanoma/connector-*/resources": ["./connectors/*/src/resources.ts"],
      "@sanoma/connector-*": ["./connectors/*/src/index.ts"]
    }
  },
  "include": [
    "types",
    "packages/*/src",
    "packages/*/test",
    "packages/*/scripts",
    "connectors/*/src",
    "connectors/*/test"
  ],
  // The app's routes and components (JSX, DOM) are checked by packages/app/tsconfig.json
  // (`typecheck:ui`). Its Node entry, src/index.ts, is still checked here through its tests.
  "exclude": ["packages/app/src"]
}
