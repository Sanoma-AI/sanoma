    "test": "vitest run",
    "lint:workflows": "node packages/cli/src/main.ts lint examples/*/workflows/*.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
