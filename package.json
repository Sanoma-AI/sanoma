{
  "name": "sanoma-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
