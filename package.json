{
  "name": "sanoma-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "bridge:download": "pnpm --filter sanoma run bridge:download",
    "postgres:download": "node packages/sanoma/scripts/download-postgres.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/readme-shots/tsconfig.json && pnpm --filter sanoma run typecheck:ui && pnpm --filter @sanoma-ai/invoices run typecheck",
    "build": "pnpm --filter sanoma run build && pnpm -r --filter \"./packages/*\" --filter \"./connectors/*\" --filter \"!sanoma\" run build",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "readme:shots": "node scripts/readme-shots/shots.ts"
  },
  "devDependencies": {
    "@sanoma-ai/connector-agent37": "workspace:*",
    "@sanoma-ai/connector-anthropic": "workspace:*",
    "@sanoma-ai/connector-bluesky": "workspace:*",
    "@sanoma-ai/connector-ghost": "workspace:*",
    "@sanoma-ai/connector-github": "workspace:*",
    "@sanoma-ai/connector-openai": "workspace:*",
    "@sanoma-ai/connector-opencode": "workspace:*",
    "@sanoma-ai/connector-pi": "workspace:*",
    "@sanoma-ai/connector-resend": "workspace:*",
    "@sanoma-ai/connector-stripe": "workspace:*",
    "@sanoma-ai/connector-supabase": "workspace:*",
    "@shadcn/helpers": "^0.3.0",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/semver": "^7.8.0",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.13.0",
    "sanoma": "workspace:*",
    "semver": "^7.8.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.28.6"
}
