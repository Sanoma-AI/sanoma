{
  // The Node entries only: startApp and its types, and the build (`./build`). `vite build` builds
  // the app itself into dist/client and dist/server.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {}
  },
  "include": [],
  "files": ["src/index.ts", "src/build.ts"]
}
