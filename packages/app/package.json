{
  "name": "@sanoma-ai/app",
  "version": "0.8.0",
  "description": "A web UI over a Sanoma config: runs, approvals, the ledger and a start form",
  "keywords": [
    "approvals",
    "audit",
    "dashboard",
    "sanoma",
    "workflows"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/packages/app#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "packages/app"
  },
  "files": [
    "dist",
    "src",
    "!src/routeTree.gen.ts",
    "tsconfig.site.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./site": {
      "types": "./src/site.ts",
      "default": "./src/site.ts"
    },
    "./ui": {
      "types": "./src/ui.ts",
      "default": "./src/ui.ts"
    },
    "./ui.css": "./src/ui.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & vite build --watch",
    "typecheck:ui": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.2",
    "@ai-sdk/harness": "1.0.158",
    "@ai-sdk/harness-claude-code": "1.0.162",
    "@ai-sdk/harness-pi": "1.0.160",
    "@ai-sdk/provider": "4.0.34",
    "@ai-sdk/react": "4.0.157",
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "ai": "7.0.153",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cookie-es": "^3.1.1",
    "lucide-react": "1.55.0",
    "marked": "^18.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "srvx": "^0.11.22",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sanoma-ai/bridge": "workspace:*",
    "@sanoma-ai/connector-anthropic": "workspace:*",
    "@sanoma-ai/connector-bluesky": "workspace:*",
    "@sanoma-ai/connector-ghost": "workspace:*",
    "@sanoma-ai/connector-github": "workspace:*",
    "@sanoma-ai/connector-resend": "workspace:*",
    "@sanoma-ai/connector-stripe": "workspace:*",
    "@sanoma-ai/connector-supabase": "workspace:*",
    "@sanoma-ai/testing": "workspace:*",
    "@sanoma-ai/workflows": "workspace:*",
    "@types/pg": "^8.23.1",
    "msw": "^3.0.2",
    "pg": "^8.23.1"
  },
  "peerDependencies": {
    "@sanoma-ai/workflows": "workspace:^"
  },
  "engines": {
    "node": ">=26"
  }
}
