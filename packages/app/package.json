{
  "name": "@sanoma/app",
  "version": "0.1.0",
  "description": "A web UI and JSON API over a Sanoma config: runs, approvals, the ledger and a start form",
  "keywords": [
    "approvals",
    "audit",
    "dashboard",
    "sanoma",
    "workflows"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/packages/app#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "packages/app"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "typecheck:ui": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "srvx": "^0.11.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@sanoma/bridge": "workspace:*",
    "@sanoma/connector-bluesky": "workspace:*",
    "@sanoma/connector-ghost": "workspace:*",
    "@sanoma/connector-github": "workspace:*",
    "@sanoma/connector-resend": "workspace:*",
    "@sanoma/testing": "workspace:*",
    "@sanoma/workflows": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-start": "^1.168.60",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "shadcn": "^4.21.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.3"
  },
  "peerDependencies": {
    "@sanoma/workflows": "^0.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
