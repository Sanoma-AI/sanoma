{
  // The compiler options a company repo extends (as `sanoma/tsconfig.json`), and this checkout's
  // root tsconfig.json too. No `types`: Node's come with `sanoma` itself (a `reference` in its
  // `dist/index.d.ts`, resolved from where sanoma is installed), so a repo installs no `@types/node`.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  }
}
