{
  "extends": ["./node_modules/@sanoma/workflows/oxlint.json"],
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "rules": {
    "typescript/no-explicit-any": "off",
    "import/no-cycle": "error"
  },
  "ignorePatterns": ["**/node_modules", "**/.sanoma", "**/dist"]
}
