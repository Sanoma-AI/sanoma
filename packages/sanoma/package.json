    "@ai-sdk/react": "4.0.157",
    "@base-ui/react": "^1.9.0",
    "@bufbuild/protobuf": "2.16.0",
    "@cedar-policy/cedar-wasm": "4.14.0",
    "@cloudflare/vite-plugin": "1.66.0",
