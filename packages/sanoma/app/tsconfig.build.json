{
  // The Node entries only: startApp and its types, the build (`./build`), the Worker's (`./bundle`) and the worker's
  // steps (`./steps`). `vite build` builds the app itself into dist/client and dist/server. Not composite: its
  // entries import modules all over src/, which a composite project would have to list one by one. So `build`
  // runs `tsc -b` on it before the package's own project, which reads its declarations from dist/.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {}
  },
  "references": [{ "path": "../workflows/tsconfig.build.json" }, { "path": "../better-auth/tsconfig.build.json" }],
  "include": [],
  "files": ["src/index.ts", "src/build.ts", "src/bundle-build.ts", "src/steps/index.ts"]
}
