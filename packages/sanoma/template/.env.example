# Copy to .env (ignored by git; `sanoma` loads it before reading the config). Never commit values.
# The first block bootstraps the runtime. Secret references use the configured store; to read
# an environment value through that store, declare an explicit env binding in sanoma.config.ts.
# Connector driver migration to named per-call authentication is tracked separately.

# Optional. Postgres for the worker and the app; default the company's own in .sanoma/postgres.
# SANOMA_DATABASE_URL=
# Built-in encrypted store only: 32 random bytes, base64. Keep separately from database backups.
# SANOMA_SECRETS_KEY=
# SANOMA_SECRETS_KEY_FILE=
# App signing: an independent 32-byte base64 key. Changing it invalidates signed sessions.
# For each key, use its value OR its _FILE path. First local start generates missing keys.
# SANOMA_SIGNING_KEY=
# SANOMA_SIGNING_KEY_FILE=
# Optional. The app's port; default 3000.
# SANOMA_APP_PORT=
# Optional. The address the app listens on; default 127.0.0.1. Any other needs GitHub sign-in.
# SANOMA_APP_HOST=
# Optional. GitHub sign-in: the OAuth client of the company's GitHub App. Who may sign in is
# resources/people.ts. Both or neither.
# SANOMA_GITHUB_CLIENT_ID=
# SANOMA_GITHUB_CLIENT_SECRET=

# anthropic: an API key, from the API Keys page of the Claude Console
ANTHROPIC_API_KEY=

# resend: an API key: a full-access one to manage domains, else sending access will do
RESEND_API_KEY=

# Optional. github: a fine-grained token with read-only repository permissions, limited to the repositories the data files declare; the resource operations need it
# GITHUB_TOKEN=

# Optional. cloud: Where Sanoma Cloud's api answers, https://www.sanoma.work unless set
# SANOMA_CLOUD_URL=

# Optional. sanoma: the wakeup service's URL: Sanoma's, or your own `sanoma wakeup`
# SANOMA_WAKEUP_URL=
# Optional. sanoma: an account's token at the wakeup service (swa_…), which creates and deletes the instances
# SANOMA_WAKEUP_ACCOUNT_TOKEN=
# Optional. sanoma: this instance's token at the wakeup service (swi_…), which /setup mints and the wakeup's create registers
# SANOMA_WAKEUP_TOKEN=
