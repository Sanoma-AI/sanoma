{
  // A part of sanoma, built by `tsc -b` after the parts it references, whose declarations it reads.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "noEmit": false,
    "composite": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {}
  },
  "references": [{ "path": "../workflows/tsconfig.build.json" }],
  "include": ["src", "../../../types"]
}
