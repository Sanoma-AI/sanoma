{
  // A part of sanoma, built by `tsc -b` before the projects that reference it, which read its declarations.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "noEmit": false,
    "composite": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {}
  },
  "include": ["src"],
  "exclude": ["src/sandbox-runner.ts"]
}
