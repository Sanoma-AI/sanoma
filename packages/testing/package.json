{
  "name": "@sanoma-ai/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Test workers, vendor replay and scenario tests for Sanoma workflows, without vendor accounts",
  "keywords": [
    "fakes",
    "sanoma",
    "testing",
    "workflows"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/packages/testing#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    },
    "./features": {
      "types": "./dist/features.d.ts",
      "default": "./dist/features.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "default": "./dist/harness.js"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "default": "./dist/replay.js"
    },
    "./scenarios": {
      "types": "./dist/scenarios.d.ts",
      "default": "./dist/scenarios.js"
    },
    "./wakeup": {
      "types": "./dist/wakeup.d.ts",
      "default": "./dist/wakeup.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@dbos-inc/dbos-sdk": "^5.2.11",
    "@sanoma-ai/connector-bluesky": "workspace:*",
    "@sanoma-ai/connector-ghost": "workspace:*",
    "@sanoma-ai/connector-github": "workspace:*",
    "@sanoma-ai/connector-resend": "workspace:*",
    "@sanoma-ai/connector-stripe": "workspace:*",
    "@sanoma-ai/workflows": "workspace:*",
    "@types/pg": "^8.23.1",
    "msw": "^3.0.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@dbos-inc/dbos-sdk": "^5.2.11",
    "@sanoma-ai/workflows": "workspace:^",
    "msw": "^3",
    "vitest": "^5",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  }
}
