{
  "name": "@sanoma/testing",
  "version": "0.1.0",
  "description": "Fake vendors and scenario tests for testing Sanoma workflows without vendor accounts",
  "keywords": [
    "fakes",
    "sanoma",
    "testing",
    "workflows"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/packages/testing#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "default": "./dist/replay.js"
    },
    "./scenarios": {
      "types": "./dist/scenarios.d.ts",
      "default": "./dist/scenarios.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "devDependencies": {
    "@sanoma/bridge": "workspace:*",
    "@sanoma/connector-bluesky": "workspace:*",
    "@sanoma/connector-ghost": "workspace:*",
    "@sanoma/connector-github": "workspace:*",
    "@sanoma/connector-resend": "workspace:*",
    "@sanoma/connector-stripe": "workspace:*",
    "@sanoma/workflows": "workspace:*",
    "msw": "^3.0.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@sanoma/bridge": "^0.1.0",
    "@sanoma/connector-bluesky": "^0.1.0",
    "@sanoma/connector-ghost": "^0.1.0",
    "@sanoma/connector-github": "^0.1.0",
    "@sanoma/connector-resend": "^0.1.0",
    "@sanoma/connector-stripe": "^0.1.0",
    "@sanoma/workflows": "^0.1.0",
    "msw": "^3",
    "vitest": "^5",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
