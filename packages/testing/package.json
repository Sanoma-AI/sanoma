{
  "name": "@sanoma/testing",
  "version": "0.1.0",
  "description": "Fake vendors for testing Sanoma workflows without vendor accounts",
  "keywords": [
    "fakes",
    "sanoma",
    "testing",
    "workflows"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/packages/testing#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "packages/testing"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@sanoma/workflows": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
