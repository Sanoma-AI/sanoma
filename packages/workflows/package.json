{
  "name": "@sanoma-ai/workflows",
  "version": "0.10.2",
  "description": "Business processes as TypeScript functions, run durably on DBOS",
  "keywords": [
    "approvals",
    "business-as-code",
    "dbos",
    "durable-execution",
    "sanoma",
    "workflows"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/packages/workflows#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "packages/workflows"
  },
  "files": [
    "dist",
    "src",
    "!src/AGENTS.md",
    "oxlint.json",
    "README.md",
    "LICENSE",
    "CLOUD-IDENTITY.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    },
    "./describe": {
      "types": "./dist/describe.d.ts",
      "default": "./dist/describe.js"
    },
    "./description": {
      "types": "./dist/description.d.ts",
      "default": "./dist/description.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "default": "./dist/fake.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./resources": {
      "types": "./dist/constructors.d.ts",
      "default": "./dist/constructors.js"
    },
    "./scenario": {
      "types": "./dist/scenario.d.ts",
      "default": "./dist/scenario.js"
    },
    "./scenarios": {
      "types": "./dist/scenarios.d.ts",
      "default": "./dist/scenarios.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "default": "./dist/shared.js"
    },
    "./wakeup-service": {
      "types": "./dist/wakeup-service.d.ts",
      "default": "./dist/wakeup-service.js"
    },
    "./cloud-identity": {
      "types": "./dist/cloud-identity.d.ts",
      "default": "./dist/cloud-identity.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.34",
    "@cedar-policy/cedar-wasm": "4.14.0",
    "@cucumber/cucumber": "13.3.0",
    "@cucumber/cucumber-expressions": "^20.1.0",
    "@cucumber/messages": "^34.2.1",
    "@cucumber/query": "16.1.1",
    "@dbos-inc/dbos-sdk": "^5.2.11",
    "@faker-js/faker": "^10.6.0",
    "ai": "7.0.153",
    "google-auth-library": "^10.5.0",
    "oxc-parser": "^0.153.0",
    "oxfmt": "^0.72.0",
    "pg": "^8.23.1",
    "randexp": "^0.5.3",
    "zod-schema-faker": "^2.1.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "msw": "^3.0.3",
    "srvx": "^0.11.22",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "engines": {
    "node": ">=26"
  },
  "//": "randexp is a dependency only because zod-schema-faker, which makes up scenario inputs, needs it as a peer."
}
