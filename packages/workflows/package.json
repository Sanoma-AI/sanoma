{
  "name": "@sanoma/workflows",
  "version": "0.1.0",
  "description": "Business processes as TypeScript functions, run durably on DBOS",
  "keywords": [
    "approvals",
    "business-as-code",
    "dbos",
    "durable-execution",
    "sanoma",
    "workflows"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/packages/workflows#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "packages/workflows"
  },
  "files": [
    "dist",
    "oxlint.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./describe": {
      "types": "./dist/describe.d.ts",
      "default": "./dist/describe.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "default": "./dist/fake.js"
    },
    "./lint": {
      "types": "./dist/lint.d.ts",
      "default": "./dist/lint.js"
    },
    "./scenario": {
      "types": "./dist/scenario.d.ts",
      "default": "./dist/scenario.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "default": "./dist/shared.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "^20.1.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@dbos-inc/dbos-sdk": "^5.2.11",
    "@faker-js/faker": "^10.6.0",
    "oxc-parser": "^0.153.0",
    "pg": "^8.23.1",
    "randexp": "^0.5.3",
    "zod-schema-faker": "^2.1.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "engines": {
    "node": ">=24"
  },
  "//": "randexp is a dependency only because zod-schema-faker, which makes up scenario inputs, needs it as a peer."
}
