{
  "name": "@sanoma-ai/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The Sanoma desktop shell: opens a company folder, runs its own sanoma launcher, and shows the app in a window",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "stage:resources": "node scripts/stage.ts",
    "start": "node scripts/electron.ts && pnpm run stage:resources && electron-forge start --",
    "package": "pnpm run stage:resources && electron-forge package",
    "make": "pnpm run stage:resources --arch arm64 --arch x64 && electron-forge make --arch arm64,x64",
    "test:e2e": "node scripts/electron.ts && pnpm run package && playwright test"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@electron/notarize": "3.1.2",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/electron-squirrel-startup": "1.0.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.0.0",
    "electron-squirrel-startup": "1.0.1",
    "update-electron-app": "3.3.0",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=26"
  },
  "productName": "Sanoma"
}
