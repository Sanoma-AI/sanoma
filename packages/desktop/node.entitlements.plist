<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Node the shell ships (Contents/Resources/node/node), under the hardened runtime of a
  Developer ID build (forge.config.mts). Three of the six its official build carries: V8's JIT;
  loading a company's native addons, which nobody on our team signed (and, for the x64 build
  under Rosetta, its translations); and writable code pages, for addons written against the
  official build. Left out: get-task-allow (notarization refuses it), DYLD_* variables and
  disabled page protection.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
