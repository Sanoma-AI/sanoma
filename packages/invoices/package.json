{
  "name": "@sanoma-ai/invoices",
  "version": "0.1.0",
  "description": "Portable invoice schemas, exact calculations and service-business adapters for browser tools and workflows",
  "keywords": [
    "cleaning",
    "invoices",
    "pet-sitting",
    "sanoma"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/packages/invoices#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "packages/invoices"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./examples": {
      "types": "./dist/examples.d.ts",
      "default": "./dist/examples.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=26"
  }
}
