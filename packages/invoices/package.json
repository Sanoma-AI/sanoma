{
  "name": "@sanoma-ai/invoices",
  "version": "0.1.0",
  "description": "Shared invoice models and React PDF rendering for browser tools and workflows",
  "keywords": [
    "cleaning",
    "invoices",
    "pet-sitting",
    "sanoma"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/packages/invoices#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "packages/invoices"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/invoice-preview.png"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./examples": {
      "types": "./dist/examples.d.ts",
      "default": "./dist/examples.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "default": "./dist/pdf.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "smoke:browser": "node scripts/browser-smoke.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "engines": {
    "node": ">=26"
  }
}
