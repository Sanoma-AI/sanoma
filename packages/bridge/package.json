{
  "name": "@sanoma/bridge",
  "version": "0.1.0",
  "description": "Client for provider-bridge, which serves OpenTofu providers' schema, import and read, a fake that replays recorded replies, and the generator of OpenTofu-backed connectors",
  "keywords": [
    "opentofu",
    "provider",
    "resources",
    "sanoma"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/packages/bridge#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "packages/bridge"
  },
  "bin": {
    "sanoma-tfschema": "./dist/tfschema/cli.js"
  },
  "files": [
    "dist",
    "proto",
    "testdata",
    "AGENTS.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "default": "./dist/fake.js"
    },
    "./tfschema": {
      "types": "./dist/tfschema.d.ts",
      "default": "./dist/tfschema.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "generate": "pnpm --package=@bufbuild/buf@1.73.0 --package=@bufbuild/protoc-gen-es@2.16.0 dlx buf generate",
    "bridge:download": "node scripts/download-bridge.ts",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0"
  },
  "devDependencies": {
    "@sanoma/workflows": "workspace:*",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@sanoma/workflows": "^0.1.0",
    "zod": "^4"
  },
  "engines": {
    "node": ">=24"
  }
}
