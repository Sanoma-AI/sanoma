{
  "name": "@sanoma/connector-resend",
  "version": "0.1.0",
  "description": "Resend Broadcasts API operations for Sanoma workflows",
  "keywords": [
    "connector",
    "email",
    "newsletter",
    "resend",
    "sanoma"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/connectors/resend#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "connectors/resend"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "default": "./dist/fake.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "default": "./dist/driver.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "generate": "pnpm --package=@redocly/cli@2.60.0 dlx redocly bundle resend --config openapi.redocly.yaml --remove-unused-components --ext yaml | pnpm dlx --package openapi-typescript@7.13.0 --package typescript@5.9.3 openapi-typescript -o src/resend-api.d.ts && oxfmt src/resend-api.d.ts",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@sanoma/workflows": "workspace:*",
    "msw": "^3.0.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@sanoma/workflows": "^0.1.0",
    "zod": "^4"
  },
  "engines": {
    "node": ">=24"
  }
}
