{
  "name": "@sanoma-ai/connector-anthropic",
  "version": "0.1.4",
  "description": "Anthropic's Claude models for Sanoma's agent, through the AI SDK, on the company's API key",
  "keywords": [
    "ai-sdk",
    "anthropic",
    "claude",
    "connector",
    "model",
    "sanoma",
    "sanoma-connector"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/connectors/anthropic#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "connectors/anthropic"
  },
  "files": [
    "dist",
    "logo.svg",
    "logo-dark.svg",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "default": "./dist/driver.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/provider": "4.0.34",
    "ai": "7.0.153"
  },
  "devDependencies": {
    "@sanoma-ai/workflows": "workspace:*",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@sanoma-ai/workflows": "workspace:^",
    "zod": "^4"
  },
  "engines": {
    "node": ">=26"
  },
  "sanoma": {
    "title": "Anthropic",
    "logo": "logo.svg",
    "logoDark": "logo-dark.svg"
  }
}
