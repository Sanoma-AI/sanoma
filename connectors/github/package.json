{
  "name": "@sanoma/connector-github",
  "version": "0.1.0",
  "description": "GitHub resources (repositories, branch protection, team membership) for Sanoma, read through the OpenTofu provider",
  "keywords": [
    "connector",
    "github",
    "opentofu",
    "resources",
    "sanoma"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/connectors/github#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "connectors/github"
  },
  "files": [
    "dist",
    "testdata/replies",
    "AGENTS.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "default": "./dist/resources.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "default": "./dist/driver.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "default": "./dist/fake.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "generate": "node ../../packages/workflows/src/tfschema/cli.ts testdata/schemas/integrations_github_6.13.0.json src/resources.config.ts src/resources.gen.ts && oxfmt src/resources.gen.ts",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "devDependencies": {
    "@sanoma/workflows": "workspace:*",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@sanoma/workflows": "^0.1.0",
    "zod": "^4"
  },
  "engines": {
    "node": ">=24"
  }
}
