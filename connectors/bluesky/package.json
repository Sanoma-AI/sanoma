{
  "name": "@sanoma-ai/connector-bluesky",
  "version": "0.4.2",
  "description": "Bluesky (AT Protocol) operations for Sanoma workflows",
  "keywords": [
    "atproto",
    "bluesky",
    "connector",
    "sanoma",
    "sanoma-connector",
    "social"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/connectors/bluesky#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "connectors/bluesky"
  },
  "files": [
    "dist",
    "features",
    "logo.svg",
    "logo-dark.svg",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "default": "./dist/fake.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "default": "./dist/driver.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@atproto/api": "^0.23.2",
    "@atproto/common-web": "^0.5.14",
    "@atproto/xrpc": "^0.8.15"
  },
  "devDependencies": {
    "@sanoma-ai/workflows": "workspace:*",
    "msw": "^3.0.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@sanoma-ai/workflows": "workspace:^",
    "zod": "^4"
  },
  "engines": {
    "node": ">=24"
  },
  "sanoma": {
    "title": "Bluesky",
    "logo": "logo.svg",
    "logoDark": "logo-dark.svg"
  }
}
