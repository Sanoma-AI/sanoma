{
  "name": "@sanoma/connector-bluesky",
  "version": "0.1.0",
  "description": "Bluesky (AT Protocol) operations for Sanoma workflows",
  "keywords": [
    "atproto",
    "bluesky",
    "connector",
    "sanoma",
    "social"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/connectors/bluesky#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "connectors/bluesky"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "default": "./dist/fake.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "devDependencies": {
    "@sanoma/workflows": "workspace:*",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@sanoma/workflows": "^0.1.0",
    "zod": "^4"
  },
  "engines": {
    "node": ">=24"
  }
}
