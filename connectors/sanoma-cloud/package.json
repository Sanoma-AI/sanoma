{
  "name": "@sanoma-ai/connector-sanoma-cloud",
  "version": "0.1.1",
  "description": "Sanoma Cloud for Sanoma: the company's database and host in Sanoma's own accounts, declared like any other",
  "keywords": [
    "connector",
    "database",
    "host",
    "resources",
    "sanoma",
    "sanoma-cloud",
    "sanoma-connector",
    "scale-to-zero"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/connectors/sanoma-cloud#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "connectors/sanoma-cloud"
  },
  "files": [
    "dist",
    "logo.svg",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./resources": {
      "types": "./dist/resources.d.ts",
      "default": "./dist/resources.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "default": "./dist/driver.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "default": "./dist/fake.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "@sanoma-ai/testing": "workspace:*",
    "@sanoma-ai/workflows": "workspace:*",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@sanoma-ai/workflows": "workspace:^",
    "zod": "^4"
  },
  "engines": {
    "node": ">=26"
  },
  "sanoma": {
    "title": "Sanoma Cloud",
    "logo": "logo.svg"
  }
}
