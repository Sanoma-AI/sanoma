{
  "name": "@sanoma-ai/connector-better-auth",
  "version": "0.2.6",
  "description": "Better Auth for Sanoma: the visitor login of public sites (email and password, or an email code) and the staff sign-in on a host (email code, invite links, GitHub), on the company's own database",
  "keywords": [
    "auth",
    "better-auth",
    "connector",
    "login",
    "sanoma",
    "sanoma-connector"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/connectors/better-auth#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "connectors/better-auth"
  },
  "files": [
    "dist",
    "drizzle",
    "!drizzle/*.config.ts",
    "logo.svg",
    "logo-dark.svg",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "generate": "drizzle-kit generate --config drizzle/visitors.config.ts && drizzle-kit generate --config drizzle/staff.config.ts"
  },
  "dependencies": {
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@sanoma-ai/testing": "workspace:*",
    "@sanoma-ai/workflows": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11"
  },
  "peerDependencies": {
    "@sanoma-ai/workflows": "workspace:^"
  },
  "engines": {
    "node": ">=26"
  },
  "sanoma": {
    "title": "Better Auth",
    "logo": "logo.svg",
    "logoDark": "logo-dark.svg"
  }
}
