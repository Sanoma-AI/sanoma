{
  "name": "@sanoma-ai/connector-ghost",
  "version": "0.4.5",
  "description": "Ghost Admin API operations for Sanoma workflows",
  "keywords": [
    "blog",
    "connector",
    "ghost",
    "sanoma",
    "sanoma-connector"
  ],
  "homepage": "https://github.com/Sanoma-AI/sanoma/tree/main/connectors/ghost#readme",
  "bugs": "https://github.com/Sanoma-AI/sanoma/issues",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanoma-AI/sanoma.git",
    "directory": "connectors/ghost"
  },
  "files": [
    "dist",
    "features",
    "logo.svg",
    "logo-dark.svg",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "default": "./dist/fake.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "default": "./dist/driver.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@sanoma-ai/workflows": "workspace:*",
    "msw": "^3.0.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@sanoma-ai/workflows": "workspace:^",
    "zod": "^4"
  },
  "engines": {
    "node": ">=26"
  },
  "sanoma": {
    "title": "Ghost",
    "logo": "logo.svg",
    "logoDark": "logo-dark.svg"
  }
}
